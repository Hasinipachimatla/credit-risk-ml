# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL in production/Docker, SQLite default for local fallback)
# For local Docker: postgresql://creditrisk:creditrisk@localhost:5432/creditrisk_db
DATABASE_URL=sqlite:///./credit_risk.db

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=CreditRiskML

# Model Configuration
MODEL_NAME=CreditRiskModel
MODEL_VERSION=v1
MODEL_DIR=models
DATA_DIR=data

# Drift Detection Thresholds (PSI & KS)
DRIFT_PSI_THRESHOLD=0.25
DRIFT_KS_PVALUE_THRESHOLD=0.05

# Model Quality / Promotion Gates
MIN_ROC_AUC=0.70
MIN_F1=0.50
MIN_RECALL=0.50
PROMOTION_MARGIN=0.01

# Decision Threshold (Calculated by evaluate.py, fallback 0.50)
DECISION_THRESHOLD=0.50
