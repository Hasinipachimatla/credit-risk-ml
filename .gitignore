# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd
*.db

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
*.egg-info/
build/
dist/

# IDEs and editors
.vscode/
.idea/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Local configuration / secrets
.env
.env.local

# MLflow and artifacts
mlruns/
mlartifacts/
models/*.pkl
models/*.pt
models/*.pth
models/*.joblib

# Data files (do not commit raw datasets or processed binaries)
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md
